<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PeakCSR</AssemblyName>
    <RootNamespace>PeakCSR</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- 路径优先级 (与 build.ps1 完全一致): 环境变量 > local.props > 内置默认 -->
  <!-- 环境变量值先存一份, local.props 导入后再拉回来, 保证环境变量始终优先 -->
  <PropertyGroup>
    <PcsrProfileDirFromEnv>$(PEAK_PROFILE_DIR)</PcsrProfileDirFromEnv>
    <PcsrManagedDirFromEnv>$(PEAK_MANAGED_DIR)</PcsrManagedDirFromEnv>
    <ProfileDir Condition="'$(PcsrProfileDirFromEnv)' != ''">$(PcsrProfileDirFromEnv)</ProfileDir>
    <GameManagedDir Condition="'$(PcsrManagedDirFromEnv)' != ''">$(PcsrManagedDirFromEnv)</GameManagedDir>
  </PropertyGroup>

  <!-- 本地可选覆盖文件 (加入 .gitignore): 定义 GameManagedDir / ProfileDir -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <ProfileDir Condition="'$(PcsrProfileDirFromEnv)' != ''">$(PcsrProfileDirFromEnv)</ProfileDir>
    <GameManagedDir Condition="'$(PcsrManagedDirFromEnv)' != ''">$(PcsrManagedDirFromEnv)</GameManagedDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameManagedDir)' == ''">
    <GameManagedDir>E:\steam\steamapps\common\PEAK\PEAK_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProfileDir)' == ''">
    <ProfileDir>C:\Users\ASUS\AppData\Roaming\Thunderstore Mod Manager\DataFolder\PEAK\profiles\RANKED</ProfileDir>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExCoreDir>$(ProfileDir)\BepInEx\core</BepInExCoreDir>
    <RankedPluginDir>$(ProfileDir)\BepInEx\plugins\PeakCode-PEAK_RANKED</RankedPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="shared\rating-rules.json" LogicalName="PeakCSR.rating-rules.json" />
    <!-- 国旗位图: 不写 LogicalName, 交给 SDK 默认命名 -->
    <EmbeddedResource Include="assets\flags\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Texture2D.LoadImage (ImageConversion) 用于解码嵌入的国旗 PNG -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>$(GameManagedDir)\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.UI.Runtime">
      <HintPath>$(GameManagedDir)\Zorro.UI.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.ControllerSupport">
      <HintPath>$(GameManagedDir)\Zorro.ControllerSupport.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(GameManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RankedPeak">
      <HintPath>$(RankedPluginDir)\RankedPeak.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 版本号单一事实源: 从 manifest.json 读取并生成 PluginVersionConstant (生成脚本见 tools/gen-version.ps1) -->
  <Target Name="GeneratePluginVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ManifestFile>$(MSBuildProjectDirectory)\manifest.json</ManifestFile>
      <GeneratedFile>$(MSBuildProjectDirectory)\src\Boot\PluginVersion.g.cs</GeneratedFile>
      <GenScript>$(MSBuildProjectDirectory)\tools\gen-version.ps1</GenScript>
    </PropertyGroup>
    <!-- 用 -File 传脚本, 路径由脚本按 $PSScriptRoot 自行推导:
         直接把仓库绝对路径拼进命令行时, 路径含空格或单引号 (O'Brien) 都会破坏解析 -->
    <Exec Condition="Exists('$(ManifestFile)')"
          WorkingDirectory="$(MSBuildProjectDirectory)\tools"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File gen-version.ps1" />
  </Target>
</Project>
